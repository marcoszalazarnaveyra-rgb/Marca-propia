---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Arrow from './Arrow.astro';

interface Props {
  id: string;
  name: string;
  handle: string;
  profileUrl: string;
  platform: 'Instagram' | 'TikTok';
  description: string;
  avatar?: ImageMetadata;
  posts: { image: ImageMetadata; alt: string; url?: string; isVideoCover?: boolean; fit?: 'cover' | 'contain' }[];
}
const { id, name, handle, profileUrl, platform, description, avatar, posts } = Astro.props;
const widths = (width: number) => [...new Set([240, 400, 600].filter(size => size < width).concat(Math.min(width, 600)))];
---
<article class="social-feed" data-social={id} data-reveal aria-labelledby={`social-${id}`}>
  <header class="feed-header">
    <div class="feed-avatar" aria-hidden="true">
      {avatar ? <Image src={avatar} alt="" width={88} height={88} fit="contain" format="webp" loading="lazy" /> : <span>{name.charAt(0)}</span>}
    </div>
    <div class="feed-name"><h4 id={`social-${id}`}>{name}</h4><p>{handle}</p></div>
    <span class="feed-platform">{platform}</span>
  </header>
  <p class="feed-description">{description}</p>
  <div class="feed-posts">
    {posts.map(post => <a href={post.url ?? profileUrl} target="_blank" rel="noopener noreferrer" aria-label={`${post.url ? 'Ver publicación' : 'Ver perfil'} de ${name}: ${post.alt} (se abre en otra pestaña)`}>
      <Image src={post.image} alt={post.alt} widths={widths(post.image.width)} sizes="(min-width: 1280px) 185px, (min-width: 768px) 15vw, 29vw" format="webp" quality={90} loading="lazy" decoding="async" style={`object-fit: ${post.fit ?? 'cover'}`} />
      {post.isVideoCover && <span class="feed-video-cover" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m9 5 10 7-10 7V5Z" fill="currentColor" /></svg></span>}
    </a>)}
  </div>
  <a class="feed-profile-link" href={profileUrl} target="_blank" rel="noopener noreferrer">Ver perfil en {platform} <Arrow /><span class="sr-only"> (se abre en otra pestaña)</span></a>
</article>

<style>
  .social-feed { min-width: 0; }
  .feed-header { display: flex; align-items: center; gap: 12px; padding-block: 16px; border-top: 1px solid var(--color-rule); }
  .feed-avatar { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; flex-shrink: 0; overflow: hidden; border: 1px solid var(--color-rule); border-radius: 50%; background: #fff; font-family: var(--font-mono); font-weight: 700; }
  .feed-avatar img { width: 100%; height: 100%; object-fit: contain; }
  .feed-name { min-width: 0; flex: 1; }
  .feed-name h4 { font-family: var(--font-mono); font-size: 14px; font-weight: 700; }
  .feed-name p { margin-top: 4px; overflow-wrap: anywhere; font-size: 12px; }
  .feed-platform { font-family: var(--font-mono); font-size: 10px; }
  .feed-description { margin-bottom: 16px; font-size: 14px; line-height: 1.65; }
  .feed-posts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3px; }
  .feed-posts > a { position: relative; display: block; min-width: 0; aspect-ratio: 3 / 4; overflow: hidden; background: #fff; }
  .feed-posts img { width: 100%; height: 100%; object-fit: cover; }
  .feed-video-cover { position: absolute; top: 8px; right: 8px; display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; background: var(--color-ink); color: #fff; }
  .feed-video-cover svg { width: 16px; height: 16px; }
  .feed-profile-link { display: inline-flex; align-items: center; gap: 16px; margin-top: 16px; padding-block: 8px; font-family: var(--font-mono); font-size: 12px; color: var(--color-brand); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 374px) { .feed-platform { display: none; } }
</style>
