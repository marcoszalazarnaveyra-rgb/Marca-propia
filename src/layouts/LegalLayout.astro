---
import '@fontsource/space-mono/latin-400.css';
import '@fontsource/space-mono/latin-700.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '../styles/global.css';
import Folder from '../components/Folder.astro';
import Arrow from '../components/Arrow.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PrivacyNotice from '../components/PrivacyNotice.astro';
import { legal } from '../data/legal';
import { resourcePolicy } from '../data/privacy';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content={resourcePolicy} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3f0e9" />
    <title>{title} | Marcos Zalazar</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={new URL(Astro.url.pathname, 'https://marcoszalazar.es')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header wrap">
      <a href="/" class="wordmark" aria-label="Marcos Zalazar, inicio"><Folder /><span>Marcos<br />Zalazar<span class="brand-dot">.</span></span></a>
      <a href="/" class="header-contact">Volver a la web <Arrow /></a>
    </header>
    <main id="contenido" class="wrap legal-main">
      <p class="eyebrow"><span class="small-square"></span> Información legal</p>
      <h1>{title}</h1>
      <p class="legal-date">Última actualización: {legal.updated}</p>
      <nav class="legal-nav" aria-label="Documentos legales">
        <a href="/aviso-legal/" aria-current={title === 'Aviso legal' ? 'page' : undefined}>Aviso legal</a>
        <a href="/politica-de-privacidad/" aria-current={title === 'Política de privacidad' ? 'page' : undefined}>Privacidad</a>
        <a href="/politica-de-cookies/" aria-current={title === 'Política de cookies' ? 'page' : undefined}>Cookies</a>
      </nav>
      <div class="legal-copy"><slot /></div>
    </main>
    <SiteFooter />
    <PrivacyNotice />
  </body>
</html>
<style>
  .legal-main { padding-top: 2.5rem; padding-bottom: 4rem; }
  .legal-main h1 { font-size: clamp(1.75rem, 4.5vw, 3rem); max-width: 22ch; }
  .legal-date { margin-top: 1.5rem; font-size: .8125rem; }
  .legal-nav { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-block: 2rem 3rem; padding-block: 1rem; border-block: 1px solid var(--color-rule); font: .75rem/1.5 var(--font-mono); }
  .legal-nav a[aria-current="page"] { color: var(--color-brand); text-decoration: underline; text-underline-offset: 5px; }
  .legal-copy { max-width: 48rem; line-height: 1.85; font-size: 1rem; overflow-wrap: anywhere; }
  .legal-copy :global(h2) { font-size: 1.125rem; margin-top: 2.5rem; margin-bottom: .75rem; }
  .legal-copy :global(h3) { font: 700 .9375rem/1.6 var(--font-mono); margin-block: 1.5rem .5rem; }
  .legal-copy :global(p) { margin-block: .75rem; }
  .legal-copy :global(a) { color: var(--color-brand); text-decoration: underline; text-underline-offset: 3px; }
  .legal-copy :global(ul) { padding-left: 1.25rem; list-style: disc; margin-block: 1rem; }
  .legal-copy :global(li) { margin-block: .5rem; }
  .legal-copy :global(dl) { border-block: 1px solid var(--color-rule); padding-block: 1rem; }
  .legal-copy :global(dt) { font: 700 .75rem/1.6 var(--font-mono); margin-top: 1rem; }
  .legal-copy :global(dt:first-child) { margin-top: 0; }
  .legal-copy :global(dd) { margin-block: .25rem .75rem; }
  .legal-copy :global(code) { font-size: .875em; }
  @media (max-width: 479px) { .legal-main { padding-top: 1.5rem; } .legal-copy { font-size: .9375rem; } }
</style>
